# Copia este fichero a .env y ajusta los valores.

# Base de datos
POSTGRES_DB=krate
POSTGRES_USER=krate
POSTGRES_PASSWORD=krate-pass

# Secreto HMAC para firmar los JWT (minimo 32 caracteres). Generar p. ej. con: openssl rand -base64 48
APP_JWT_SECRET=L/N4phsoYDKeQfdNgvIOlh8CAGnaDv59zNtDKy/7krSNyBZilrjusRzjv6v4nFPK
APP_JWT_TTL_HOURS=24

# Puertos publicados en el host
BACKEND_PORT=8080
MANAGEMENT_PORT=8081
VOTING_PORT=8082

# URL publica de la voting app: se usa para construir el enlace de cada punto de votacion
APP_PUBLIC_VOTING_URL=http://localhost:8082
# Origenes permitidos por CORS (solo necesario si los frontends se sirven desde otro dominio/puerto)
APP_CORS_ORIGINS=http://localhost:8081,http://localhost:8082

# Datos de prueba: con true, en CADA arranque del backend se vacia la base de datos y se crea
# el gestor gestor-test@gmail.com / gestor-test123 con items, votaciones y puntos de ejemplo.
APP_SEED_ENABLED=false
