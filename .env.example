# Copia este fichero a .env y ajusta los valores.

# Base de datos
POSTGRES_DB=krate
POSTGRES_USER=krate
POSTGRES_PASSWORD=krate-pass

# Secreto HMAC para firmar los JWT (minimo 32 caracteres). Generar p. ej. con: openssl rand -base64 48
APP_JWT_SECRET=cambia-este-valor-por-uno-generado-con-openssl-rand-base64-48
APP_JWT_TTL_HOURS=24

# Puertos publicados en el host
BACKEND_PORT=8080
MANAGEMENT_PORT=8081
VOTING_PORT=8082

# URL publica de la voting app: se usa para construir el enlace de cada punto de votacion
APP_PUBLIC_VOTING_URL=http://localhost:8082
# Origenes permitidos por CORS (solo necesario si los frontends se sirven desde otro dominio/puerto)
APP_CORS_ORIGINS=http://localhost:8081,http://localhost:8082

# Datos de prueba: con true, en CADA arranque del backend se vacia la base de datos y se crea
# el gestor gestor-test@gmail.com / gestor-test123 con items, votaciones y puntos de ejemplo.
APP_SEED_ENABLED=false

# --- Solo produccion (docker-compose.prod.yml) -------------------------------
# Subdominios publicos. De VOTING_HOST se derivan APP_PUBLIC_VOTING_URL y los
# enlaces/QR de los puntos de votacion, asi que debe ser el definitivo.
VOTING_HOST=krate-vote.duckdns.org
PANEL_HOST=krate-manage.duckdns.org
# Propietario de las imagenes ghcr.io/<owner>/krate-backend, krate-management y krate-voting
GHCR_OWNER=unaydf
# Etiqueta a desplegar: latest, o sha-<commit> para fijar o retroceder de version
IMAGE_TAG=latest
